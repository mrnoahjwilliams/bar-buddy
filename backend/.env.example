# Local Compose database only. Never use these credentials for hosted databases.
# Spring reads this as properties: use unquoted KEY=value lines, without export.
DB_URL=jdbc:postgresql://127.0.0.1:54329/bar_buddy
DB_USERNAME=bar_buddy
DB_PASSWORD=bar_buddy_local
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080

# Supabase Auth. Leave disabled until a project is configured.
AUTH_ENABLED=false
AUTH_ISSUER=https://YOUR_PROJECT_REF.supabase.co/auth/v1
AUTH_JWK_SET_URI=https://YOUR_PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json
AUTH_AUDIENCE=authenticated
