            "type" : "number"
          },
          "unit" : {
            "type" : "string"
          }
        }
      },
      "IngredientDetail" : {
        "type" : "object",
        "properties" : {
          "category" : {
            "type" : "string"
          },
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "name" : {
            "type" : "string"
          },
          "relatedCocktails" : {
            "type" : "array",
            "items" : {
