            "type" : "integer",
            "format" : "int32"
          }
        }
      },
      "IngredientSummary" : {
        "type" : "object",
        "properties" : {
          "category" : {
            "type" : "string"
          },
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "name" : {
            "type" : "string"
          }
        }
      },
      "MeResponse" : {
        "type" : "object",
        "properties" : {
          "createdAt" : {
            "type" : "string",
            "format" : "date-time"
          },
          "id" : {
            "type" : "string",
            "format" : "uuid"
          }
        },
        "required" : [ "createdAt", "id" ]
